Server.default.options.outDevice_("ASIO : Voicemeeter Virtual ASIO");
Server.default.options.inDevice_("ASIO : Voicemeeter Virtual ASIO");

(
s.reboot {
	s.options.sampleRate = 48000; // some interfaces might need other values like 48000 (ASIO on Windows defaults to 44100)
	// boot the server and start SuperDirt
	s.waitForBoot {

		// Conceptual implementation generated by Claude 3.5 Sonnet

		// Buffer management for source samples
		(
			~loadSamples = {|folders, done|
				var buffers = List.new;
				var total = folders.size;
				var loaded = 0;
				var wavFiles = folders.collect { |folder|
					PathName(folder).entries.select { |file|
						file.extension == "wav"
					}
				}.flat;
				wavFiles.do({|path|
					Buffer.read(s, path.asAbsolutePath, action: { |buf|
						buffers.add(buf);
						loaded = loaded + 1;
						if (loaded == total) {
							done.(buffers);
						}
					});
				});
			};

			// Grain extraction and analysis
			~analyzeBuffer = { |buffer, grainSize = 0.1, finalAction|
				var duration = buffer.duration;
				var numGrains = (duration / grainSize).ceil.asInteger;
				var grains = Array.new(numGrains);
				var doneGrains = 0;

				numGrains.do { |i|
					var startTime = i * grainSize;
					var grain = Dictionary.new;
					var startFrame = (startTime * buffer.sampleRate).asInteger;
					var numFrames = (grainSize * buffer.sampleRate).asInteger;
					var pitchBuf = Buffer.alloc(s, 1);
					var loudnessBuf = Buffer.alloc(s, 1);
					var mfccsBuf = Buffer.alloc(s, 1);
					var doneCount = 0;
					var checkDone = {
						doneCount = doneCount + 1;
						// two, because two analysis processes
						if (doneCount == 2) {
							grains.add(grain);
							doneGrains = doneGrains + 1;
						};
						if (doneGrains == (numGrains - 1)) {
							finalAction.(grains);
						};
					};

					// Store grain info
					grain.put(\startFrame, startFrame);
					grain.put(\numFrames, numFrames);

					// FluCoMa buffer-based analysis (client-side)
					FluidBufPitch.process(s, buffer, startFrame: startFrame, numFrames: numFrames, features: pitchBuf, action: {
						pitchBuf.loadToFloatArray(action: { |arr|
							grain.put(\pitch, arr[0]);
							pitchBuf.free;
							checkDone.();
						});
					});

					FluidBufLoudness.process(s, buffer, startFrame, numFrames, features: loudnessBuf, action: {
						loudnessBuf.loadToFloatArray(action: { |arr|
							grain.put(\loudness, arr[0]);
							loudnessBuf.free;
							checkDone.();
						});
					});
					// TODO: implement timbral analyses, too
					/*
					FluidBufMFCC.process(s, buffer, startFrame, numFrames, features: mfccsBuf, action: {
						mfccsBuf.loadToFloatArray(action: { |arr|
							arr.postln;
							grain.put(\mfcc, arr[0]);
							mfccsBuf.free;
						});
					});
					*/
				};
			};

			~analyzeAllBuffers = { |buffers, action|
				buffers.collect { |buf| ~analyzeBuffer.(buf, 0.1, {
					|grains|
					// here, 'grains' is an array of dictionaries per grain for one source path
					action.(grains);
				})};
			};

			// K-means clustering of grains
			~clusterGrains = {|grains, numClusters=8|
				var features = grains.collect({|grain|
					// Combine features into a single vector
					[grain[\pitch], grain[\loudness]]; // TODO: ++ grain[\mfcc];
				});

				// Using FluCoMa's KMeans
				// TODO: possibly wrong use of FluidKMeans
				var clusterer = FluidKMeans.new(s, numClusters);
				var clusters = clusterer.fit(features, action:);
				// Associate clusters with grains
				grains.do({|grain, i|
					grain.put(\cluster, clusters[i]);
				});

				grains;
			};

			// Find closest matching grains for target features
			~findMatchingGrains = {|targetFeatures, grains, numNeighbors=5|
				var distances = grains.collect({|grain|
					var grainFeatures = [grain[\pitch], grain[\loudness]]; // TODO: ++ grain[\mfcc];
					var distance = 0;

					// Calculate Euclidean distance
					targetFeatures.size.do({|i|
						distance = distance + ((targetFeatures[i] - grainFeatures[i]).squared);
					});

					(grain: grain, distance: distance.sqrt);
				});

				// Sort by distance and return top matches
				distances.sort({|a, b| a.distance < b.distance }).keep(numNeighbors);
			};

			// Main concatenative synthesis routine
			~concatenativeSynth = {|inputBuffer, sourceGrains, grainSize=0.1|
				var numGrains = (BufDur.ir(inputBuffer) / grainSize).ceil;
				var outputBuffer = Buffer.alloc(s, inputBuffer.numFrames);

				numGrains.do({|i|
					var startTime = i * grainSize;
					var inputFeatures = [
						FluidPitch.kr(inputBuffer, startTime, grainSize),
						FluidLoudness.kr(inputBuffer, startTime, grainSize),
						// FluidMFCC.kr(inputBuffer, startTime, grainSize)
					];

					var matchingGrains = ~findMatchingGrains.(inputFeatures, sourceGrains);
					var selectedGrain = matchingGrains.choose.grain;

					// Copy grain to output buffer with crossfade
					outputBuffer.copyData(
						selectedGrain[\buffer],
						selectedGrain[\startFrame],
						selectedGrain[\numFrames],
						i * grainSize * outputBuffer.sampleRate
					);
				});

				outputBuffer;
			};

			~inputBuffer = Buffer.read(s, "C:/Users/Li/Documents/Ableton/samples/Dariacore drum kit v4/Acapellas/150 BPM Jane & kmoe - homeswitcher (Acapella).wav");
			~sourcePaths = [
				"C:/Users/Li/Documents/Ableton/samples/@XFILESORG_ @thecxdy - armored core (drum & loop collection)/melodies",
				"C:/Users/Li/Documents/Ableton/samples/@XFILESORG_ @thecxdy - armored core (drum & loop collection)/sound effects",
			];
			~loadSamples.(~sourcePaths, { |buffers|
				~sourceBuffers = buffers;
				~clusteredGrains = ~analyzeAllBuffers.(buffers, ~clusterGrains);
				// ~outputBuffer = ~concatenativeSynth.(~inputBuffer, ~clusteredGrains.flat);
			});
		)
	}
};
)

